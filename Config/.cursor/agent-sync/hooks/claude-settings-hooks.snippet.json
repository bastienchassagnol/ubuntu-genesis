{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'ROOT=\"${AGENT_BUNDLE_ROOT:-$HOME/repos/ubuntu-genesis/Config/.cursor}\"; test -x \"$ROOT/agent-sync/agent-sync.sh\" && \"$ROOT/agent-sync/agent-sync.sh\" verify || true'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'ROOT=\"${AGENT_BUNDLE_ROOT:-$HOME/repos/ubuntu-genesis/Config/.cursor}\"; test -x \"$ROOT/agent-sync/agent-sync.sh\" && \"$ROOT/agent-sync/agent-sync.sh\" after-edit || true'"
          }
        ]
      }
    ]
  }
}